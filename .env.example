# A separate Discord application with Activities enabled.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
ALLOWED_GUILD_IDS=
ALLOWED_CHANNEL_IDS=

# Both paths must stay outside dist; data/ and private/ are ignored locally.
WORLD_DATABASE=data/worlds.sqlite
ENGINE_ROOT=private/engine
